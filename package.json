{
  "name": "onesmallui-monorepo",
  "private": true,
  "version": "0.5.0",
  "description": "OneSmallUI (1SmUI): a futuristic, WCAG AAA React + SCSS component library.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @onesmall/ui && npm run build -w @onesmallui/docs",
    "build:lib": "npm run build -w @onesmall/ui",
    "dev": "npm run build:lib && npm run dev -w @onesmallui/docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @onesmall/ui",
    "test": "npm run test -w @onesmall/ui",
    "check": "npm run check:contrast && npm run typecheck && npm run lint && npm test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "test:layout": "node scripts/layout-test.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "playwright": "^1.56.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "^10.14.0"
    },
    "eslint": {
      "minimatch": "^11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.3"
    }
  }
}
