{
  "name": "@onesmall/ui",
  "version": "0.4.0",
  "description": "OneSmallUI (1SmUI): a futuristic, WCAG AAA accessible React + TypeScript + SCSS component library with light/dark themes, utilities, drag and drop, and upload drop zones.",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "scss",
    "typescript",
    "accessibility",
    "wcag",
    "dark-mode",
    "drag-and-drop",
    "dropzone"
  ],
  "license": "MIT",
  "author": "Joshua Small (https://onesmall.company)",
  "homepage": "https://ui.onesmall.company",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WasteOfADrumBum/one-small-ui.git",
    "directory": "packages/onesmallui"
  },
  "bugs": {
    "url": "https://github.com/WasteOfADrumBum/one-small-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/onesmallui.css",
    "./styles.min.css": "./dist/onesmallui.min.css",
    "./icons": {
      "import": {
        "types": "./dist/icons.d.ts",
        "default": "./dist/icons.js"
      },
      "require": {
        "types": "./dist/icons.d.cts",
        "default": "./dist/icons.cjs"
      }
    },
    "./dom": {
      "import": {
        "types": "./dist/dom.d.ts",
        "default": "./dist/dom.js"
      },
      "require": {
        "types": "./dist/dom.d.cts",
        "default": "./dist/dom.cjs"
      }
    },
    "./scss": "./scss/index.scss",
    "./scss/*": "./scss/*",
    "./tokens.json": "./tokens/themes.json",
    "./package.json": "./package.json",
    "./agent/SKILL.md": "./agent/SKILL.md"
  },
  "files": [
    "dist",
    "scss",
    "tokens",
    "agent",
    "CHANGELOG.md"
  ],
  "scripts": {
    "tokens": "node ../../scripts/build-tokens.mjs",
    "build:js": "vite build && vite build -c vite.dom.config.ts && vite build -c vite.dom-iife.config.ts",
    "build:types": "tsc -p tsconfig.build.json && rollup -c rollup.dts.config.mjs && node -e \"fs.rmSync('dist/types',{recursive:true,force:true})\"",
    "build:css": "sass --no-source-map --load-path=node_modules scss/index.scss dist/onesmallui.css && sass --no-source-map --style=compressed scss/index.scss dist/onesmallui.min.css",
    "build": "npm run tokens && node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && npm run build:js && npm run build:types && npm run build:css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "^4.64.5",
    "rollup-plugin-dts": "^6.5.1",
    "sass": "^1.89.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18"
  }
}
