{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@onesmall/ui": ["../../packages/onesmallui/src/index.ts"],
      "@onesmall/ui/dom": ["../../packages/onesmallui/src/dom/index.ts"],
      "@onesmall/ui/icons": ["../../packages/onesmallui/src/icons/index.ts"]
    }
  },
  "include": ["src"]
}
